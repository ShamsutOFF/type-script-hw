{
  "compilerOptions": {
    "target": "ES2020",  // ← ИЗМЕНИ НА ES2020 или ES2019
    "lib": ["ES2020", "DOM"],  // ← ДОБАВЬ ЭТУ СТРОКУ
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "./src",  // ← РЕКОМЕНДУЮ ДОБАВИТЬ
    "experimentalDecorators": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}